# Splashpool configuration
# Copy this file to .env and fill it in:  cp .env.example .env
# Never commit .env: it holds your RPC password. It is already in .gitignore.
# Changes take effect when the pool restarts.

# ---------------------------------------------------------------------------
# Bitcoin node (required)
# ---------------------------------------------------------------------------

# Address of your bitcoind RPC, without the port.
# Same machine: http://127.0.0.1   Another machine: http://your-node-ip
# Docker on the same PC: http://host.docker.internal
#   (then add rpcallowip=172.16.0.0/12 to bitcoin.conf)
BITCOIN_RPC_URL=http://127.0.0.1
BITCOIN_RPC_PORT=8332

# Either a user and password (rpcauth in bitcoin.conf)...
BITCOIN_RPC_USER=your-rpc-user
BITCOIN_RPC_PASSWORD=your-rpc-password
# ...or leave those empty and point at bitcoind's .cookie file instead.
BITCOIN_RPC_COOKIEFILE=

# RPC timeout in milliseconds.
BITCOIN_RPC_TIMEOUT=10000

# Optional, recommended: new-block notifications over ZMQ, faster than polling.
# Enable in bitcoin.conf with:  zmqpubrawblock=tcp://*:3000
#BITCOIN_ZMQ_HOST="tcp://127.0.0.1:3000"

# mainnet | testnet | regtest   (testnet covers both testnet3 and testnet4)
NETWORK=testnet

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------

# Stratum port that miners connect to.
STRATUM_PORT=3333
STRATUM_MAX_CONNECTIONS_PER_LISTENER=10000

# Pool API. It listens on localhost only by default. Put a reverse proxy in
# front of it rather than exposing it directly. Set API_HOST=0.0.0.0 to listen
# on every interface.
API_PORT=3334
API_HOST=127.0.0.1
# true serves the API over HTTPS. Then put your own secrets/key.pem and
# secrets/cert.pem (relative to where the pool runs). No certificate ships with
# this repo, and *.pem is in .gitignore.
API_SECURE=false

# ---------------------------------------------------------------------------
# Coinbase tag
# ---------------------------------------------------------------------------

# Text written into every coinbase. It's how block explorers know which pool
# mined a block, so use your own pool's name. The live Splash Pool uses
# -=+SplashPool+=-. The pool refuses to start a job if the tag is too long to fit.
POOL_IDENTIFIER="Your-Pool-Name"

# ---------------------------------------------------------------------------
# Splash payouts (see docs/SPLASH-PAYOUTS.md)
# ---------------------------------------------------------------------------

# true pays everyone straight from the coinbase:
#   1. the Splash Bonus goes to the block finder, with no fee taken
#   2. the pool fee is taken from the rest (the shared reward) only
#   3. what's left is split by work over the share window
SPLASH_PAYOUTS=true

# Where the pool fee is paid. It must be a valid address for NETWORK, or the
# pool refuses to start.
SPLASH_FEE_ADDRESS=your-fee-address

# Fee on the shared reward, in parts per million: 1250 = 0.125%, 0 = no fee.
# It is never taken from the Splash Bonus.
SPLASH_FEE_PPM=1250

# The Splash Bonus paid to the miner whose share finds the block, in sats.
# 112500000 = 1.125 BTC. If the block reward is smaller, the finder gets the
# whole reward.
SPLASH_BONUS_SATS=112500000

# How far back shares count toward the split, in hours (72 = 3 days).
SHARE_WINDOW_HOURS=72

# Slices smaller than this many sats aren't paid. Their portion goes to the
# block's paid miners.
SPLASH_MIN_PAYOUT_SATS=10000

# Most split payouts in one coinbase, and the byte budget for all coinbase
# outputs. Some miner firmware crashes on large coinbases (AxeOS 2.11 and
# OSM 2.15 at about 6,000 bytes), so keep the byte budget at 5000 or lower.
SPLASH_MAX_SPLIT_OUTPUTS=250
SPLASH_MAX_COINBASE_OUTPUT_BYTES=5000

# Optional append-only log of credited shares (JSON lines). It lets you rebuild
# the share window after a crash.
#SPLASH_SHARE_LOG=../data/shares.jsonl

# Found blocks are kept here, one file each, and resubmitted until 100 deep.
#SPLASH_FOUND_BLOCKS_DIR=../data/found-blocks

# ---------------------------------------------------------------------------
# Share difficulty and abuse limits
# ---------------------------------------------------------------------------

# Lowest share difficulty allowed. Unset means 512 on mainnet and off elsewhere.
#SPLASH_MIN_DIFFICULTY=512

# Disconnect a connection whose rejected shares in one minute reach this count
# AND this fraction of its submissions. 0 turns it off.
#SPLASH_REJECT_LIMIT=200
#SPLASH_REJECT_RATIO=0.9

# Per-IP rules. 0 turns a limit off. A connection that's mostly junk is always
# closed. Its whole IP is banned only after BAN_CONNECTIONS of those and no valid
# share from it in BAN_WINDOW_MINUTES.
# log: bans and the connect rate only log. enforce: they act. The cap always acts.
#SPLASH_IP_MODE=log
#SPLASH_IP_MAX_CONNECTIONS=1000
#SPLASH_IP_CONNECTS_PER_MINUTE=3000
#SPLASH_IP_BAN_CONNECTIONS=5
#SPLASH_IP_BAN_WINDOW_MINUTES=5
#SPLASH_IP_BAN_MINUTES=1,10,60
# A new IP, or one just out of a ban, can't be banned for this long.
#SPLASH_IP_BAN_GRACE_SECONDS=120
# Known farms, as IPv4 addresses or CIDRs. Private (LAN) addresses are exempt
# unless SPLASH_IP_EXEMPT_LAN=false.
#SPLASH_IP_ALLOWLIST=
#SPLASH_IP_EXEMPT_LAN=true

# Close a connection that hasn't subscribed and authorized within this many
# seconds, and count it as junk for the per-IP rules. 0 (default) = off.
#SPLASH_AUTH_TIMEOUT_SECONDS=30

# true logs one "Splash conn:" line per closed connection: IP, worker, user
# agent, why it closed, how long it lasted, accepted/rejected/invalid counts.
# Summarize with: journalctl ... | grep "Splash conn" | grep -o 'reason=[a-z-]*' | sort | uniq -c
#SPLASH_CONN_LOG=false

# ---------------------------------------------------------------------------
# Optional upstream public-pool features
# ---------------------------------------------------------------------------

#TELEGRAM_BOT_TOKEN=
#DISCORD_BOT_TOKEN=
#DISCORD_BOT_CLIENTID=
#DISCORD_BOT_GUILD_ID=
#DISCORD_BOT_CHANNEL_ID=

# Upstream's optional dev-fee address. Splash payouts don't use it.
#DEV_FEE_ADDRESS=
