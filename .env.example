# bitcoin node running in your private network 192.168.1.0/24
BITCOIN_RPC_URL=http://192.168.1.100

# bitcoin node running undockered on the same PC
# needs to add rpcallowip=172.16.0.0/12 to your bitcoin.conf
#BITCOIN_RPC_URL=http://host.docker.internal

BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_TIMEOUT=10000

# You can use this instead of BITCOIN_RPC_USER and BITCOIN_RPC_PASSWORD
BITCOIN_RPC_COOKIEFILE=

# Enable in bitcoin.conf with
# zmqpubrawblock=tcp://*:3000
# BITCOIN_ZMQ_HOST="tcp://192.168.1.100:3000"

API_PORT=3334
STRATUM_PORT=3333
STRATUM_MAX_CONNECTIONS_PER_LISTENER=10000

#optional telegram bot
#TELEGRAM_BOT_TOKEN=

#optional discord bot
#DISCORD_BOT_CLIENTID=
#DISCORD_BOT_GUILD_ID=
#DISCORD_BOT_CHANNEL_ID=

#optional
DEV_FEE_ADDRESS=
# mainnet | testnet
NETWORK=mainnet

API_SECURE=false
# Default is "Public-Pool", you can change it to any string it will be removed if it will make the block or coinbase script too big
POOL_IDENTIFIER="Public-Pool"

# Found blocks are kept here, one file each, and resubmitted until 100 deep
#SPLASH_FOUND_BLOCKS_DIR=../data/found-blocks

# Splash Pool payouts (see docs/SPLASH-PAYOUTS.md)
#SPLASH_PAYOUTS=true
#SPLASH_FEE_ADDRESS=
# Splash Bonus to the block finder, no fee taken (1.125 BTC)
#SPLASH_BONUS_SATS=112500000
# Fee on the shared reward (reward minus the bonus), parts per million: 1250 = 0.125%
#SPLASH_FEE_PPM=1250
#POOL_IDENTIFIER="-=+SplashPool+=-"

# Per-IP rules (restart to apply; a restart also clears bans). 0 turns a limit off.
# A connection that's mostly junk is always closed. Its whole IP is banned only
# after BAN_CONNECTIONS of those and no valid share from it in BAN_WINDOW_MINUTES.
# log: bans and the connect rate only log. enforce: they act. The cap always acts.
#SPLASH_IP_MODE=log
#SPLASH_IP_MAX_CONNECTIONS=1000
#SPLASH_IP_CONNECTS_PER_MINUTE=3000
#SPLASH_IP_BAN_CONNECTIONS=5
#SPLASH_IP_BAN_WINDOW_MINUTES=5
#SPLASH_IP_BAN_MINUTES=1,10,60
# A new IP, or one just out of a ban, can't be banned for this long.
#SPLASH_IP_BAN_GRACE_SECONDS=120
# Known farms, as IPv4 addresses or CIDRs. The LAN is exempt already.
#SPLASH_IP_ALLOWLIST=
# What happened: journalctl --user -u splash-pool | grep "IP guard"
